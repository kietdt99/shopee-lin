{
  "name": "shopee-lin",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "supabase:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/start-local-supabase.ps1",
    "supabase:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/stop-local-supabase.ps1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:api:local": "node scripts/qa/verify-local-api-security.mjs",
    "test:bundle": "pnpm build && node scripts/qa/check-bundle-size.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "supabase": "3.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "2.1.9"
  }
}
